rename (a b c d) (course_opport foreign_share reg_unemplrate reg_density)
rename (e f g h) (tax gdp_per_resident refugee hospital_bet2012)
rename (i j k l) (land_cons vac_hous afd_votes cdu_csu_votes)
gen int year = yr + 2010
soepdrop yr
replace course_opport = course_opport/100000
replace foreign_share = foreign_share/100
replace reg_unemplrate = reg_unemplrate/100
replace reg_density = reg_density/100
replace tax = tax/100
replace hospital_bet2012 = hospital_bet2012/100
replace land_cons = land_cons/100
replace vac_hous = vac_hous/100
replace afd_votes = afd_votes/100
replace cdu_csu_votes = cdu_csu_votes/100
