gen double zc = _n*(2*cond(missing(kkz),0,kkz) + ///
    3*cond(missing(yr),0,yr) + 5*cond(missing(a),0,a) + ///
    7*cond(missing(b),0,b) + 11*cond(missing(c),0,c) + ///
    13*cond(missing(d),0,d) + 17*cond(missing(e),0,e) + ///
    19*cond(missing(f),0,f) + 23*cond(missing(g),0,g) + ///
    29*cond(missing(h),0,h) + 31*cond(missing(i),0,i) + ///
    37*cond(missing(j),0,j) + 41*cond(missing(k),0,k) + ///
    43*cond(missing(l),0,l))
