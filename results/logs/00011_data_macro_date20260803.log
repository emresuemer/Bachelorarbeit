. #delimit cr
delimiter now cr
. 
. label var  kkz  "Kreisziffer"

. label var  year  "Year"

. label var  kkz_name  "Kreis name"

. 
. label var tax  "municipal tax amount in € per inhabitant, lev:y,kkz"  

. label var  al_vac  "vacancies relative to unemployed, lev:y,kkz"        //Anteil der offenen Stellen an den Arbeitslosen

. label var al_vac_exp "expert vacancies per unemployed expert, lev:y,kkz" 

. label var al_vac_spec "specialist vacancies relative to unemployed specialists, lev:y,kkz" 

. label var al_vac_skill "skilled work vacancies relative to skilled unemployed, lev:y,kkz" 

. label var al_vac_unskill "unskilled vacancies relative to unskilled unemployed, lev:y,kkz" 

. label var vac_exp  "vacancies: experts, lev:y,kkz" 

. label var vac_spec  "vacancies: specialists, lev:y,kkz" 

. label var vac_skill  "vacancies: skilled workers, lev:y,kkz"

. label var vac_unskill  "vacancies: unskilled workers, lev:y,kkz" 

. label var hospital_bet  "hospital beds per 1,000 inhabitants, lev:y,kkz" 

. 
. label var unemp_for  "share of unemployed foreigners in the unemployed, lev:y,kkz" 

. label var emp_for_nat  "ratio of the employment rate of foreigners to total, lev:y,kkz" 

. label var shb2sh  "welfare state resipients per 1000 inhabitants, lev:y,kkz" 

. label var rentprice  "rental prices, lev:y,kkz" 

. label var land_cons  "land consumption, lev:y,kkz" 

. 
. * hospital_bet is not available after 2016
. * fix to values in 2012
. gen helpvar = hospital_bet if year == 2012
(9,624 missing values generated)

. bys kkz: egen hospital_bet2012 = max(helpvar)

. lab var hospital_bet2012 "hospital beds per 1,000 inhabitants:2012,kkz"

. drop helpvar

. 
. * most of variables (exept tax) are not available for 2018 and after
.         * we consider lagged macro variables (i.e., if arrived in 2018, 
.         * variables from 2017 apply);
.         * hence, arrivals in 2019 will have missings
.         * these are only few
.         * still, to avoid missings, we consider year 2018 as the last available
.         * and carryfoward for 2019
. 
. keep if year >= 2013 & year <= 2017
(8,020 observations deleted)

. expand 2 if year==2017, gen(dupindicator)
(401 observations created)

. replace year = 2018 if dupindicator == 1
(401 real changes made)

. 
. list kkz if land_cons>=.

